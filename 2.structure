#include <stdio.h>

struct Employee
{
    int id;
    char name[20];
    char department[20];
    float basic;
    float hra;
    float da;
    float gross;
};

int main()
{
    struct Employee emp[10], temp;
    int n, i, j;

    printf("Enter number of employees: ");
    scanf("%d", &n);

    // Input employee details
    for(i = 0; i < n; i++)
    {
        printf("\nEnter details of Employee %d\n", i + 1);

        printf("ID: ");
        scanf("%d", &emp[i].id);

        printf("Name: ");
        scanf("%s", emp[i].name);

        printf("Department: ");
        scanf("%s", emp[i].department);

        printf("Basic Salary: ");
        scanf("%f", &emp[i].basic);

        // Calculate HRA, DA and Gross Salary
        emp[i].hra = emp[i].basic * 0.20;
        emp[i].da = emp[i].basic * 0.15;
        emp[i].gross = emp[i].basic + emp[i].hra + emp[i].da;
    }

    // Sort by Gross Salary (highest first)
    for(i = 0; i < n - 1; i++)
    {
        for(j = i + 1; j < n; j++)
        {
            if(emp[i].gross > emp[j].gross)
            {
                temp = emp[i];
                emp[i] = emp[j];
                emp[j] = temp;
            }
        }
    }

    // Display in table form
    printf("\n---------------------------------------------------------------\n");
    printf(" ID   Name       Dept.      Basic      HRA       DA      Gross\n");
    printf("---------------------------------------------------------------\n");

    for(i = 0; i < n; i++)
    {
        printf("%-4d %-10s %-10s %-9.2f %-8.2f %-8.2f %.2f\n",
               emp[i].id,
               emp[i].name,
               emp[i].department,
               emp[i].basic,
               emp[i].hra,
               emp[i].da,
               emp[i].gross);
    }

    printf("---------------------------------------------------------------\n");

    return 0;
}
