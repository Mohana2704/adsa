#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Photo
{
    char name[30];
    struct Photo *prev;
    struct Photo *next;
};

struct Photo *head = NULL;

// Insert photo at a position
void insertPhoto()
{
    struct Photo *newNode, *temp;
    int position, i;

    newNode = (struct Photo *)malloc(sizeof(struct Photo));

    printf("\nEnter photo name: ");
    scanf("%s", newNode->name);

    printf("Enter position: ");
    scanf("%d", &position);

    newNode->prev = NULL;
    newNode->next = NULL;

    // Insert at first position
    if(position == 1)
    {
        newNode->next = head;

        if(head != NULL)
            head->prev = newNode;

        head = newNode;
    }
    else
    {
        temp = head;

        for(i = 1; i < position - 1 && temp != NULL; i++)
        {
            temp = temp->next;
        }

        if(temp == NULL)
        {
            printf("Invalid position!\n");
            free(newNode);
            return;
        }

        newNode->next = temp->next;
        newNode->prev = temp;

        if(temp->next != NULL)
            temp->next->prev = newNode;

        temp->next = newNode;
    }

    printf("Photo inserted successfully!\n");
}

// Delete photo by name
void deletePhoto()
{
    struct Photo *temp;
    char name[30];

    printf("\nEnter photo name to delete: ");
    scanf("%s", name);

    temp = head;

    while(temp != NULL && strcmp(temp->name, name) != 0)
    {
        temp = temp->next;
    }

    if(temp == NULL)
    {
        printf("Photo not found!\n");
        return;
    }

    if(temp->prev != NULL)
        temp->prev->next = temp->next;
    else
        head = temp->next;

    if(temp->next != NULL)
        temp->next->prev = temp->prev;

    free(temp);

    printf("Photo deleted successfully!\n");
}

// Display photos forward
void forward()
{
    struct Photo *temp;

    if(head == NULL)
    {
        printf("\nNo photos available!\n");
        return;
    }

    temp = head;

    printf("\nPhotos in Forward Direction:\n");

    while(temp != NULL)
    {
        printf("%s -> ", temp->name);
        temp = temp->next;
    }

    printf("NULL\n");
}

// Display photos backward
void backward()
{
    struct Photo *temp;

    if(head == NULL)
    {
        printf("\nNo photos available!\n");
        return;
    }

    temp = head;

    // Go to last photo
    while(temp->next != NULL)
    {
        temp = temp->next;
    }

    printf("\nPhotos in Backward Direction:\n");

    while(temp != NULL)
    {
        printf("%s -> ", temp->name);
        temp = temp->prev;
    }

    printf("NULL\n");
}

int main()
{
    int choice;

    while(1)
    {
        printf("\n===== PHOTO MENU =====\n");
        printf("1. Insert Photo\n");
        printf("2. Delete Photo\n");
        printf("3. Forward Navigation\n");
        printf("4. Backward Navigation\n");
        printf("5. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                insertPhoto();
                break;

            case 2:
                deletePhoto();
                break;

            case 3:
                forward();
                break;

            case 4:
                backward();
                break;

            case 5:
                exit(0);

            default:
                printf("Invalid choice!\n");
        }
    }

    return 0;
}
