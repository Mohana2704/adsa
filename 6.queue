#include <stdio.h>
#include <stdlib.h>

#define MAX 10

int queue[MAX];
int front = -1;
int rear = -1;

// Add a print job
void enqueue()
{
    int job;

    if(rear == MAX - 1)
    {
        printf("\nQueue is full!\n");
        return;
    }

    printf("\nEnter Job ID: ");
    scanf("%d", &job);

    if(front == -1)
        front = 0;

    rear++;
    queue[rear] = job;

    printf("Print job added successfully!\n");
}

// Process a print job
void dequeue()
{
    if(front == -1 || front > rear)
    {
        printf("\nNo pending print jobs!\n");
        return;
    }

    printf("\nProcessing Job ID: %d\n", queue[front]);
    front++;

    if(front > rear)
    {
        front = -1;
        rear = -1;
    }
}

// Display pending jobs
void display()
{
    int i;

    if(front == -1)
    {
        printf("\nNo pending print jobs!\n");
        return;
    }

    printf("\nPending Print Jobs:\n");

    for(i = front; i <= rear; i++)
    {
        printf("Job ID: %d\n", queue[i]);
    }
}

int main()
{
    int choice;

    while(1)
    {
        printf("\n===== PRINT JOB MANAGEMENT =====\n");
        printf("1. Submit Print Job\n");
        printf("2. Process Print Job\n");
        printf("3. Display Pending Jobs\n");
        printf("4. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                enqueue();
                display();
                break;

            case 2:
                dequeue();
                display();
                break;

            case 3:
                display();
                break;

            case 4:
                exit(0);

            default:
                printf("\nInvalid choice!\n");
        }
    }

    return 0;
}
